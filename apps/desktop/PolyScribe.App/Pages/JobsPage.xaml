<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PolyScribe.App.Pages.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PolyScribe.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PolyScribe.App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="任务" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
            <CommandBar
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Icon="Refresh"
                    Label="刷新" />
                <AppBarButton
                    Command="{x:Bind ViewModel.OpenJobsFolderCommand}"
                    Label="打开目录">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <SelectorBar
            x:Name="FilterBar"
            Grid.Row="1"
            SelectionChanged="FilterBar_SelectionChanged">
            <SelectorBarItem IsSelected="True" Tag="all" Text="全部" />
            <SelectorBarItem Tag="running" Text="进行中" />
            <SelectorBarItem Tag="succeeded" Text="已完成" />
            <SelectorBarItem Tag="failed" Text="失败" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <ListView
                x:Name="JobList"
                IsItemClickEnabled="True"
                ItemClick="JobList_ItemClick"
                ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind app:BindHelpers.CollapsedIf(ViewModel.IsEmpty), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobItemViewModel">
                        <Grid Padding="4,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="{x:Bind StatusGlyph}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind CreatedLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind StatusLabel}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind DurationLabel}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind app:BindHelpers.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8F1;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="没有符合筛选的任务" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="导入音频后，任务会出现在这里。关闭应用不会丢弃已写入磁盘的清单。" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
