<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PolyScribe.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PolyScribe.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PolyScribe.App.Models"
    xmlns:vm="using:PolyScribe.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Spacing="20">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="桌面壳只消费 CLI 与任务清单。路径、主题和诊断都写在本机，不会改模型权重。" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="外观" />
            <Border Style="{StaticResource CardStyle}">
                <ComboBox
                    Header="应用主题"
                    MinWidth="240"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Themes}"
                    SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="仓库" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="PolyScribe 根目录" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.RepositoryRoot, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button Command="{x:Bind ViewModel.PickRepositoryCommand}" Content="选择文件夹" />
                    <TextBlock Margin="0,8,0,0" Text="任务目录" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.JobsDirectory, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.PickJobsCommand}" Content="选择任务目录" />
                        <Button Command="{x:Bind ViewModel.ResetJobsCommand}" Content="恢复默认" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="uv" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.UvPath, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="环境诊断" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="调用 `uv run polyscribe doctor`。诊断只报告问题，不会下载模型。"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.RunDoctorCommand}"
                            Content="运行诊断"
                            Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsDoctorBusy, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.DoctorSummary, Mode=OneWay}"
                        Severity="Informational"
                        Visibility="{x:Bind app:BindHelpers.VisibleIf(ViewModel.DoctorSummary), Mode=OneWay}" />
                    <ListView
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.DoctorChecks, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DoctorCheck">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Hint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="关于" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="PolyScribe" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.VersionLabel}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="面向 Windows 的本地 AI 音乐转录与和声分析。非商业用途；仍须遵守代码、权重与资产许可。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
