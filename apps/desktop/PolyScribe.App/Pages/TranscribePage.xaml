<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PolyScribe.App.Pages.TranscribePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PolyScribe.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PolyScribe.App.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Spacing="16">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="转录" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="导入一首歌，选择钢琴、人声、和声或和弦产物。GUI 只调用已稳定的 CLI，不会在本进程加载模型。" />
            </StackPanel>

            <InfoBar
                IsClosable="True"
                IsOpen="True"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind app:BindHelpers.VisibleIf(ViewModel.ErrorMessage), Mode=OneWay}" />

            <InfoBar
                IsClosable="True"
                IsOpen="True"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="Success"
                Visibility="{x:Bind app:BindHelpers.VisibleIf(ViewModel.InfoMessage), Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.EnvironmentSummary, Mode=OneWay}"
                Severity="Warning"
                Title="仓库未就绪"
                Visibility="{x:Bind app:BindHelpers.CollapsedIf(ViewModel.RepositoryReady), Mode=OneWay}" />

            <Border
                x:Name="DropZone"
                AllowDrop="True"
                AutomationProperties.Name="将音频拖放到此处，或浏览选择文件"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                Padding="32">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="36"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE189;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SourceFolder, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="浏览音频文件"
                            Click="Browse_Click"
                            Content="浏览"
                            ToolTipService.ToolTip="Ctrl+O" />
                        <Button
                            AutomationProperties.Name="清除已选文件"
                            Command="{x:Bind ViewModel.ClearSourceCommand}"
                            Content="清除"
                            Visibility="{x:Bind app:BindHelpers.VisibleIf(ViewModel.HasSource), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="产物目标" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Targets}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="2"
                        MinColumnSpacing="12"
                        MinItemWidth="280"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:TargetOption">
                        <ToggleButton
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                            Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    Glyph="{x:Bind Glyph}"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EnvironmentSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind app:BindHelpers.VisibleIf(ViewModel.IsBusy), Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.StartCommand}"
                        Content="开始转录"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
