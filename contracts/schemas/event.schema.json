{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyscribe.local/schemas/event.schema.json",
  "title": "PolyScribe worker event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "stage_id",
    "event_type",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "job_id": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": ["started", "progress", "artifact", "warning", "succeeded", "failed"]
    },
    "timestamp": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  }
}
